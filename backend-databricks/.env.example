# Copy to .env and fill in for local development. Never commit the real .env (see .gitignore).
# rg/config.py already defaults PGHOST/PGDATABASE/LAKEBASE_ENDPOINT to this project's real values, and
# PGUSER to the deployed app's own service principal - override PGUSER below with your own Databricks
# username for local development (your identity, not the app's), and leave PGPASSWORD blank so rg/db.py
# generates its own short-lived token via the SDK (needs a `databricks auth login`'d CLI profile).
PGUSER=
PGPASSWORD=
PGSSLMODE=require

# --- Databricks workspace (data-plane SQL Warehouse + Model Serving + Volumes) ---
DATABRICKS_HOST=
DATABRICKS_TOKEN=
DBX_HTTP_PATH=
DBX_CATALOG=deepak
DBX_SCHEMA=insurance_v04
DBX_APP_SCHEMA=rg_v04_app
